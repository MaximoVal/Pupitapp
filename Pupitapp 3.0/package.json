    "build": "electron-builder",
    "package-win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "35.2.0",
    "electron-builder": "^24.13.1"
  },
  "build": {
    "appId": "com.pupitapp.app",
    "productName": "Pupitapp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "iconoPupita.ico", 
